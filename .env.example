# Local defaults. npm start does not load .env automatically.
# After copying to .env: node --env-file=.env server/index.mjs
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
DB_PATH=data/weekly-plan.sqlite
COOKIE_SECURE=0
TRUST_PROXY=0

# Configure these for your deployment; see docs/OPERATIONS.md.
APP_ORIGIN=
SETUP_TOKEN=
