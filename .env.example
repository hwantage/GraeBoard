# npm start / dev / backup / restore / admin load .env when present.
# Explicit environment variables take precedence over this file.
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
DB_PATH=data/weekly-plan.sqlite
# Document image files (PNG/JPEG/WebP uploads are stored as WebP).
DOCUMENT_IMAGES_DIR=data/document-images
COOKIE_SECURE=0
TRUST_PROXY=0

# Configure these for your deployment; see docs/OPERATIONS.md.
APP_ORIGIN=
SETUP_TOKEN=
