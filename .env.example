# npm start / dev / backup / restore / admin load .env when present.
# Explicit environment variables take precedence over this file.
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
DB_PATH=data/weekly-plan.sqlite
# Document image files (PNG/JPEG/WebP uploads are stored as WebP).
DOCUMENT_IMAGES_DIR=data/document-images
COOKIE_SECURE=0
TRUST_PROXY=0

# Configure these for your deployment; see docs/OPERATIONS.md.
APP_ORIGIN=
SETUP_TOKEN=

# Optional internal Git synchronization; empty profiles preserve local-only behavior.
# Generate one persistent UUID per installation. Never reuse an active writer ID.
GRAEBOARD_INSTALLATION_ID=
GRAEBOARD_SYNC_PROFILES=[]
# Persistent bare Git clones: <GRAEBOARD_SYNC_DIR>/<profileId>.
# Production: absolute path outside release directory. Backup/transfer need
# this directory and Git CLI to recover L-excluded image bytes.
GRAEBOARD_SYNC_DIR=data/sync
# AES-256-GCM key: base64 of 32 random bytes, stored outside the DB/backup.
GRAEBOARD_SYNC_KEY=
GRAEBOARD_SYNC_KEY_ID=default
# Register tokens with npm run sync:credential (stdin); do not put them in profiles.
# Full setup and Cloudflare/Supabase secrets: docs/CLOUD_SETUP.md

# Graceful HTTP/sync shutdown deadline: default 30000 ms, range 100..600000.
GRAEBOARD_SHUTDOWN_TIMEOUT_MS=30000
