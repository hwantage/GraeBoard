{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graeboard",
  "main": "worker/entry.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "images": { "binding": "IMAGES" },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "GRAEBOARD_SITE": "external",
    "APP_ORIGIN": "https://board.example.com",
    "ACCESS_ISSUER": "https://your-team.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "replace-with-graeboard-application-audience",
    "SITE_NAME": "외부 사이트",
    "SITE_TEAM_ID": "11111111-1111-4111-8111-111111111111",
    "SYNC_MAX_STATE_BYTES": "4194304",
    "SYNC_MAX_ENTITIES": "12000",
    "INSTALLATION_ID": "replace-with-persistent-external-uuid",
    "PEER_INSTALLATION_ID": "replace-with-internal-installation-uuid",
    "SYNC_PROFILES": "[{\"profileId\":\"team-prod\",\"name\":\"팀 외부\",\"teamId\":\"11111111-1111-4111-8111-111111111111\",\"repository\":\"example/team-data\",\"databaseBinding\":\"PG_SITE\",\"bucketBinding\":\"R2_TEAM\",\"githubSecret\":\"GIT_TEAM\"}]",
  },
  // Replace the local example ID before deployment. Hyperdrive caching must
  // be disabled. Each team deploys its own Worker and single Supabase project.
  "hyperdrive": [
    { "binding": "PG_SITE", "id": "00000000000000000000000000000000" },
  ],
  "r2_buckets": [
    { "binding": "R2_TEAM", "bucket_name": "replace-with-team-private-bucket" },
  ],
}
