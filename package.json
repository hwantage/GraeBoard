{
  "name": "graeboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "backup": "node scripts/backup.mjs",
    "admin": "node scripts/admin.mjs",
    "restore": "node scripts/restore.mjs",
    "format": "prettier --write src server shared scripts tests",
    "performance": "node scripts/performance.mjs",
    "performance:stress": "node scripts/load-test.mjs",
    "performance:ui": "node scripts/ui-performance.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/nanum-gothic-coding": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@fontsource/pretendard": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.53.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
