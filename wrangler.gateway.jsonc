{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graeboard-gateway",
  "main": "worker/gateway.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "images": { "binding": "IMAGES" },
  "triggers": { "crons": [] },
  "vars": {
    "APP_ORIGIN": "https://your-project.pages.dev",
    "SITE_TEAM_ID": "11111111-1111-4111-8111-111111111111",
    "GRAEBOARD_EDGE_URL": "https://your-project.supabase.co/functions/v1/graeboard",
  },
  "r2_buckets": [
    { "binding": "R2_TEAM", "bucket_name": "replace-with-team-private-bucket" },
  ],
}
